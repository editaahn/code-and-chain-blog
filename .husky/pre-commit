changed=$(git diff --cached --name-only --diff-filter=ACM | grep 'content/blog/ko/.*\.mdx$' || true)
for f in $changed; do
  en_file="content/blog/en/${f#content/blog/ko/}"
  if [ -e "$en_file" ]; then
    echo "Skipping translation (English file already exists): $en_file"
    continue
  fi
  [ -f "$f" ] && /opt/homebrew/opt/node@20/bin/node node_modules/.bin/tsx scripts/translate-post.ts "$f"
done
git add content/blog/en/ --ignore-removal || true
